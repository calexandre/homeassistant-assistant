{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/.github/hooks/ssh-ha-readonly-guard.py\"",
            "powershell": "$root = if ($env:CLAUDE_PLUGIN_ROOT) { $env:CLAUDE_PLUGIN_ROOT } elseif ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { '.' }; python (Join-Path $root '.github\\hooks\\ssh-ha-readonly-guard.py')",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
